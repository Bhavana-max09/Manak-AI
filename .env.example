# MANAK AI Environment Variables
# API Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=info
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# Database Configuration
# Default is local SQLite. To use PostgreSQL: postgresql://user:password@localhost:5432/manak_ai
DATABASE_URL=sqlite:///./manak_ai.db

# Vector / Hybrid Storage Configuration
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# LLM Providers (Optional - system includes built-in grounded neural engine)
# For local Qwen serving via Ollama:
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# For cloud / vLLM OpenAI-compatible endpoint:
OPENAI_API_BASE=
OPENAI_API_KEY=
LLM_MODEL=qwen3-30b-instruct
